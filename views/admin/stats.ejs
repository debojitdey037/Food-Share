<%- include('../partials/header') %>
<%- include('../partials/navbar', { activeTab: 'stats' }) %>

<main class="main-content">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; color: var(--primary-dark);">Platform Analytics & Area Breakdown</h1>
      <p style="color: var(--text-muted);">Real-time aggregated metrics for food waste reduction and postal code distribution</p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Summary Metric Cards Grid -->
  <div class="grid-4" style="margin-bottom: 2rem;">
    <div class="stat-card">
      <div class="stat-icon green">
        <i class="fa-solid fa-boxes-stacked"></i>
      </div>
      <div>
        <div class="stat-value"><%= metrics.totalDonations %></div>
        <div class="stat-label">Total Donation Posts</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon blue">
        <i class="fa-solid fa-hand-holding-heart"></i>
      </div>
      <div>
        <div class="stat-value"><%= metrics.totalQuantityRedistributed %></div>
        <div class="stat-label">Total Units/Servings Saved</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon amber">
        <i class="fa-solid fa-bell"></i>
      </div>
      <div>
        <div class="stat-value"><%= metrics.activeDonations %></div>
        <div class="stat-label">Active / Pending Pickup</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon purple">
        <i class="fa-solid fa-building-ngo"></i>
      </div>
      <div>
        <div class="stat-value"><%= metrics.donorCount %> Donors / <%= metrics.ngoCount %> NGOs</div>
        <div class="stat-label">Registered Organizations</div>
      </div>
    </div>
  </div>

  <!-- Status Distribution Overview Card -->
  <div class="card" style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.3rem; margin-bottom: 1rem;"><i class="fa-solid fa-chart-pie" style="color: var(--primary);"></i> Donation Lifecycle Status Breakdown</h2>
    <div class="grid-4">
      <div style="background: #f0fdf4; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #bbf7d0;">
        <div style="font-size: 0.85rem; color: #166534; font-weight: 600;">Completed / Redistributed</div>
        <div style="font-size: 1.6rem; font-weight: 800; color: #14532d;"><%= metrics.completedDonations %></div>
      </div>
      <div style="background: #fffbeb; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #fde68a;">
        <div style="font-size: 0.85rem; color: #92400e; font-weight: 600;">Active / In Progress</div>
        <div style="font-size: 1.6rem; font-weight: 800; color: #78350f;"><%= metrics.activeDonations %></div>
      </div>
      <div style="background: #fef2f2; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #fca5a5;">
        <div style="font-size: 0.85rem; color: #991b1b; font-weight: 600;">Expired (Unclaimed)</div>
        <div style="font-size: 1.6rem; font-weight: 800; color: #7f1d1d;"><%= metrics.expiredDonations %></div>
      </div>
      <div style="background: #f8fafc; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #cbd5e1;">
        <div style="font-size: 0.85rem; color: #475569; font-weight: 600;">Donor Cancelled</div>
        <div style="font-size: 1.6rem; font-weight: 800; color: #1e293b;"><%= metrics.cancelledDonations %></div>
      </div>
    </div>
  </div>

  <!-- Area-wise / Pincode Breakdown Table -->
  <h2 style="font-size: 1.3rem; margin-bottom: 0.75rem;"><i class="fa-solid fa-map-location-dot" style="color: var(--secondary);"></i> Area & Pincode Wise Performance</h2>

  <% if (pincodeBreakdown.length === 0) { %>
    <div class="card" style="text-align: center; padding: 2rem;">
      <p style="color: var(--text-muted);">No area data available yet.</p>
    </div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Postal Code / Area Pincode</th>
            <th>Total Donations Posted</th>
            <th>Currently Available</th>
            <th>Completed Deliveries</th>
            <th>Total Food Units Redistributed</th>
          </tr>
        </thead>
        <tbody>
          <% pincodeBreakdown.forEach(function(row) { %>
            <tr>
              <td>
                <span class="user-badge" style="font-size: 0.95rem;">
                  <i class="fa-solid fa-location-dot" style="color: var(--danger);"></i> <%= row._id %>
                </span>
              </td>
              <td><strong><%= row.totalPosts %></strong></td>
              <td>
                <span class="badge badge-Available"><%= row.availablePosts %> Available</span>
              </td>
              <td>
                <span class="badge badge-Completed"><%= row.completedPosts %> Completed</span>
              </td>
              <td>
                <strong style="color: var(--primary-dark); font-size: 1.05rem;"><%= row.redistributedQty %> units</strong>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
