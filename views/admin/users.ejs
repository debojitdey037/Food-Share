<%- include('../partials/header') %>
<%- include('../partials/navbar', { activeTab: 'users' }) %>

<main class="main-content">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; color: var(--primary-dark);">User Management</h1>
      <p style="color: var(--text-muted);">Manage platform donors and NGOs. Deactivate accounts to suspend access if needed.</p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Search & Role Filter Bar -->
  <div class="filter-bar">
    <form action="/admin/users" method="GET" class="search-form">
      <input type="text" name="search" value="<%= searchQuery %>" placeholder="Search by name, email, organization, pincode...">
      <select name="role" onchange="this.form.submit()" style="width: auto;">
        <option value="ALL" <%= currentRoleFilter === 'ALL' ? 'selected' : '' %>>All Roles</option>
        <option value="donor" <%= currentRoleFilter === 'donor' ? 'selected' : '' %>>Donors Only</option>
        <option value="ngo" <%= currentRoleFilter === 'ngo' ? 'selected' : '' %>>NGOs Only</option>
      </select>
      <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-magnifying-glass"></i> Filter
      </button>
      <% if (searchQuery || currentRoleFilter !== 'ALL') { %>
        <a href="/admin/users" class="btn btn-secondary">Clear</a>
      <% } %>
    </form>

    <div style="font-size: 0.9rem; color: var(--text-muted);">
      Total Users: <strong><%= users.length %></strong>
    </div>
  </div>

  <!-- Users Table -->
  <% if (users.length === 0) { %>
    <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
      <i class="fa-solid fa-users-slash" style="font-size: 3rem; color: var(--text-light); margin-bottom: 1rem;"></i>
      <h3>No Users Found</h3>
      <p style="color: var(--text-muted);">No users match your filter criteria.</p>
    </div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>User / Contact Person</th>
            <th>Organization</th>
            <th>Role</th>
            <th>Email & Phone</th>
            <th>Pincode / Address</th>
            <th>Account Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td>
                <strong><%= u.name %></strong>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Joined: <%= new Date(u.createdAt).toLocaleDateString() %></div>
              </td>
              <td><%= u.organizationName || 'N/A' %></td>
              <td>
                <span class="role-tag <%= u.role %>"><%= u.role %></span>
              </td>
              <td style="font-size: 0.85rem;">
                <div><i class="fa-solid fa-envelope"></i> <%= u.email %></div>
                <div><i class="fa-solid fa-phone"></i> <%= u.phone %></div>
              </td>
              <td style="font-size: 0.85rem;">
                <div><%= u.address %></div>
                <div>Pincode: <strong><%= u.pincode %></strong></div>
              </td>
              <td>
                <% if (u.isActive) { %>
                  <span class="badge badge-Available"><i class="fa-solid fa-circle"></i> Active</span>
                <% } else { %>
                  <span class="badge badge-Expired"><i class="fa-solid fa-ban"></i> Suspended</span>
                <% } %>
              </td>
              <td>
                <form action="/admin/users/toggle/<%= u._id %>" method="POST">
                  <% if (u.isActive) { %>
                    <button type="submit" class="btn btn-danger btn-sm js-confirm-toggle" data-action="suspend" data-name="<%= u.name %>">
                      <i class="fa-solid fa-user-xmark"></i> Deactivate
                    </button>
                  <% } else { %>
                    <button type="submit" class="btn btn-primary btn-sm js-confirm-toggle" data-action="activate" data-name="<%= u.name %>">
                      <i class="fa-solid fa-user-check"></i> Activate
                    </button>
                  <% } %>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
