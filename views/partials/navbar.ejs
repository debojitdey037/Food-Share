<header class="navbar">
  <div class="nav-container">
    <a href="/" class="brand-logo">
      <i class="fa-solid fa-hand-holding-heart"></i>
      FoodShare
    </a>

    <nav>
      <ul class="nav-links">
        <% if (user) { %>
          <% if (user.role === 'donor') { %>
            <li>
              <a href="/donor/dashboard" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-list-check"></i> My Donations
              </a>
            </li>
            <li>
              <a href="/donor/create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus"></i> Post Food
              </a>
            </li>
          <% } else if (user.role === 'ngo') { %>
            <li>
              <a href="/ngo/feed" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'feed' ? 'active' : '' %>">
                <i class="fa-solid fa-utensils"></i> Available Food Feed
              </a>
            </li>
            <li>
              <a href="/ngo/history" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'history' ? 'active' : '' %>">
                <i class="fa-solid fa-truck-ramp-box"></i> My Claimed Food
              </a>
            </li>
          <% } else if (user.role === 'admin') { %>
            <li>
              <a href="/admin/dashboard" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'donations' ? 'active' : '' %>">
                <i class="fa-solid fa-table-list"></i> All Donations
              </a>
            </li>
            <li>
              <a href="/admin/users" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'users' ? 'active' : '' %>">
                <i class="fa-solid fa-users-gear"></i> Users
              </a>
            </li>
            <li>
              <a href="/admin/stats" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'stats' ? 'active' : '' %>">
                <i class="fa-solid fa-chart-line"></i> Impact Analytics
              </a>
            </li>
          <% } %>

          <li>
            <div class="user-badge">
              <i class="fa-solid fa-user-circle"></i>
              <span><%= user.name %></span>
              <span class="role-tag <%= user.role %>"><%= user.role %></span>
            </div>
          </li>
          <li>
            <a href="/auth/logout" class="nav-link" style="color: var(--danger);">
              <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
          </li>
        <% } else { %>
          <li>
            <a href="/" class="nav-link">Home</a>
          </li>
          <li>
            <a href="/auth/login" class="nav-link">Log In</a>
          </li>
          <li>
            <a href="/auth/signup" class="btn btn-primary btn-sm">
              <i class="fa-solid fa-user-plus"></i> Join Platform
            </a>
          </li>
        <% } %>
      </ul>
    </nav>
  </div>
</header>
